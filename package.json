{
	"name": "wedez",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"dev": "bun run dev:web",
		"dev:web": "bun run --cwd apps/web dev",
		"dev:invitation": "bun run --cwd apps/invitation dev",
		"build": "bun run build:web && bun run build:invitation",
		"build:web": "bun run --cwd apps/web build",
		"build:invitation": "bun run --cwd apps/invitation build",
		"preview:web": "bun run --cwd apps/web preview",
		"preview:invitation": "bun run --cwd apps/invitation preview",
		"prepare": "bun run sync || echo ''",
		"sync": "bun run --cwd apps/web sync && bun run --cwd apps/invitation sync",
		"check": "bun run check:web && bun run check:invitation",
		"check:web": "bun run --cwd apps/web check",
		"check:invitation": "bun run --cwd apps/invitation check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1"
	}
}
