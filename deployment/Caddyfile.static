:80 {
	handle /healthz {
		respond "ok" 200
	}

	handle {
		root * /srv
		encode zstd gzip

		@immutable path /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /_wedez_revision Cache-Control "no-store"

		try_files {path} {path}.html {path}/ /200.html
		file_server {
			precompressed br gzip
		}
	}
}
