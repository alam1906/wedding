:80 {
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Cache-Control "no-store"
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		root * /srv
		encode zstd gzip
		try_files {path} {path}.html {path}/ /200.html
		file_server {
			index 200.html
			precompressed br gzip
		}
	}
}
