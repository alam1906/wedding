# Image yang dibangun GitHub Actions dan ditarik oleh Dokploy.
WEDEZ_WEB_IMAGE=ghcr.io/alam1906/wedding-web:production
WEDEZ_ADMIN_IMAGE=ghcr.io/alam1906/wedding-admin:production
WEDEZ_INVITATION_IMAGE=ghcr.io/alam1906/wedding-invitation:production
WEDEZ_POCKETBASE_IMAGE=ghcr.io/alam1906/wedding-pocketbase:production

# PocketBase runtime. Ganti seluruh placeholder sebelum deployment pertama.
PB_ENCRYPTION_KEY=replace-with-exactly-32-characters
WEDEZ_APP_URL=https://wedez.id
WEDEZ_API_URL=https://api.wedez.id
WEDEZ_PRO_PRICE=50000

# Duitku runtime. Nilai production tidak boleh disimpan di Git.
DUITKU_ENV=production
DUITKU_MERCHANT_CODE=replace-me
DUITKU_API_KEY=replace-me
DUITKU_API_URL=https://api-prod.duitku.com
DUITKU_CALLBACK_URL=https://api.wedez.id/api/wedez/payments/duitku/callback
DUITKU_RETURN_URL=https://wedez.id/upgrade
